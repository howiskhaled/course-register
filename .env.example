# Copy this file to .env and fill in your own values. NEVER commit .env or share it.

# --- register.py (auto-registration) --- your own KFUPM login, used only on your own computer
KFUPM_ID=202012345
KFUPM_PASSWORD=your-password-here

# --- radar.py (Telegram seat alerts) --- needs NO KFUPM login
# Create a bot with @BotFather in Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
# RADAR_INTERVAL=120            # seconds between seat checks (minimum 30)
# RADAR_ALLOWED_CHATS=          # comma-separated Telegram chat ids; empty = anyone can use your bot
# RADAR_MAX_WATCH=25            # max watched CRNs per chat

# --- optional overrides ---
# BANNER_BASE=https://banner9-registration.kfupm.edu.sa/StudentRegistrationSsb
# HEADLESS=true                 # false = show the browser window
# BROWSER_CHANNEL=chrome        # uses your installed Chrome; falls back to Playwright's Chromium
